# Postgres connection string — Coolify's PostgreSQL resource gives you this.
DATABASE_URL=postgres://user:pass@host:5432/dbname

PORT=3000

# Comma-separated browser origins allowed to call this API. '*' or empty = any.
CORS_ORIGIN=https://wishlist.example.com

# Family members created on first boot (only while the members table is empty).
SEED_MEMBERS=Alice,Bob,Carol

# 'true' also inserts a few example wishes on first boot.
SEED_DEMO=false

# Optional shared bearer token. If set, every request except /health must send
# `Authorization: Bearer <API_TOKEN>`. Must match VITE_API_TOKEN in the frontend.
API_TOKEN=
